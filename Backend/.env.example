# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/thehungrysport
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# First admin account, created on startup if it doesn't exist
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Dashboard -> Settings -> API Keys). Leave empty to disable online payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
